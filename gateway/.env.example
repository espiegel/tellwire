# All gateway settings. Only GATEWAY_ALLOWED_ORIGINS is mandatory.
GATEWAY_LISTEN=:8080
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173        # exact origins, comma separated; no wildcards
GATEWAY_UPSTREAMS=default=dunemud.net:6788:tls       # name=host:port:tls|plain
# GATEWAY_UPSTREAM_CA_FILE=/path/to/extra-roots.pem  # extra trusted CAs; verification is never disabled
# GATEWAY_TRUSTED_PROXIES=172.29.0.0/24              # peers whose X-Forwarded-For is believed
GATEWAY_MAX_CONNECTIONS=500
GATEWAY_MAX_CONNECTIONS_PER_IP=10
GATEWAY_IDLE_TIMEOUT=2h
GATEWAY_DIAL_TIMEOUT=10s
GATEWAY_WRITE_TIMEOUT=15s
GATEWAY_PING_INTERVAL=30s
GATEWAY_SHUTDOWN_TIMEOUT=15s
GATEWAY_MAX_MESSAGE_BYTES=16384
GATEWAY_MAX_SUBNEG_BYTES=65536
GATEWAY_OUT_QUEUE=64
GATEWAY_INPUT_LINES_PER_SEC=10
GATEWAY_INPUT_BURST=40
GATEWAY_GMCP=true
GATEWAY_GMCP_HELLO=true
GATEWAY_GMCP_SUPPORTS=Char 1,Room 1,Comm.Channel 1
GATEWAY_CLIENT_NAME=Tellwire
GATEWAY_LOG_LEVEL=info                               # debug|info|warn|error
GATEWAY_LOG_FORMAT=json                              # json|text
