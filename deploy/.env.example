# Copy to deploy/.env and edit. Used by compose.prod.yaml.
SITE_ADDRESS=play.dunemud.net
GATEWAY_ALLOWED_ORIGINS=https://play.dunemud.net

# Allowlisted upstreams: name=host:port:tls|plain, comma separated. The first is the default.
# 6788 is the documented secure port. 4241 (development) is UNVERIFIED: do not enable it
# until you have confirmed it with the DuneMUD admins.
GATEWAY_UPSTREAMS=default=dunemud.net:6788:tls

GATEWAY_MAX_CONNECTIONS=500
GATEWAY_MAX_CONNECTIONS_PER_IP=10
GATEWAY_LOG_LEVEL=info
